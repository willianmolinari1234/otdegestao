rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funcionários: leitura/gravação por qualquer usuário autenticado.
    // (O documento é criado no cadastro com id == uid do usuário.)
    match /employees/{uid} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // Dados da dashboard — qualquer funcionário autenticado.
    match /tasks/{id}       { allow read, write: if request.auth != null; }
    match /clients/{id}     { allow read, write: if request.auth != null; }
    match /customers/{id}   { allow read, write: if request.auth != null; }
    match /products/{id}    { allow read, write: if request.auth != null; }
    match /promos/{id}      { allow read, write: if request.auth != null; }
    match /config/{id}      { allow read, write: if request.auth != null; }
    match /performance/{id} { allow read, write: if request.auth != null; }

    // Preenchidas pelo backend (Admin SDK, ignora estas regras). Cliente só lê.
    match /sales/{id}       { allow read: if request.auth != null; allow write: if false; }
    match /tools/{id}       { allow read: if request.auth != null; allow write: if false; }

    // Status das integrações (sem tokens) — a dashboard lê para exibir "Conectado".
    match /integracoes/{id} { allow read: if request.auth != null; allow write: if false; }

    // Repasse financeiro (escrow) — preenchido pelo backend, só leitura no app.
    match /financeiro/{id}  { allow read: if request.auth != null; allow write: if false; }

    // Tokens da Shopee — só o backend. Nenhum acesso pelo navegador.
    match /shopee_auth/{id} { allow read, write: if false; }
  }
}
