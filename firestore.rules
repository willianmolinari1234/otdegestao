rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Papéis ─────────────────────────────────────────────────────────
    // Estar logado NÃO basta: o Firebase Auth aceita cadastro de qualquer
    // pessoa (a apiKey do front é pública por design). O que dá acesso é
    // existir um cadastro de funcionário criado por um administrador.
    function ehFuncionario() {
      return request.auth != null
        && exists(/databases/$(database)/documents/employees/$(request.auth.uid));
    }
    function ehAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.role == "admin";
    }

    // ── Papéis externos: cliente e especialista ────────────────────────
    // Vêm da CLAIM do token, não de um documento. Cada get() dentro de uma
    // regra é uma leitura cobrada e um atraso em TODA consulta da tela — e a
    // área do cliente vai listar produtos, que é justamente onde isso doeria.
    // A fonte da verdade é accounts/{uid}; uma Cloud Function espelha nas
    // claims a cada escrita.
    //
    // .get(campo, padrão) e não .campo: token sem a claim (todo funcionário,
    // por exemplo) faria a regra ERRAR em vez de simplesmente negar.
    function papel()   { return request.auth != null ? request.auth.token.get("papel", "") : ""; }
    function ehCliente()      { return papel() == "cliente"; }
    function ehEspecialista() { return papel() == "especialista"; }
    function meuCust() { return request.auth.token.get("custId", ""); }
    function meuMkt()  { return request.auth.token.get("mkt", ""); }

    // ── Contas externas ────────────────────────────────────────────────
    // O dono lê a própria conta — a tela precisa saber quem ele é. Escrita
    // NUNCA pelo navegador: é a gravação aqui que dispara o espelho das
    // claims, então um cliente que pudesse editar o próprio custId trocaria
    // de dono numa linha e levaria a claim junto.
    match /accounts/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || ehFuncionario());
      allow write: if false;
    }

    // ── Funcionários ───────────────────────────────────────────────────
    // Criação/edição/exclusão SÓ pelo backend (Admin SDK, ignora as regras)
    // ou por um admin já existente. Ninguém se auto-cadastra.
    match /employees/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || ehAdmin());
      allow create, delete: if ehAdmin();
      // Admin edita qualquer um; o próprio pode editar seu cadastro,
      // mas NUNCA mudar o próprio papel.
      allow update: if ehAdmin()
        || (request.auth.uid == uid
            && request.resource.data.role == resource.data.role);
    }

    // ── Dados operacionais: qualquer funcionário ───────────────────────
    match /tasks/{id}       { allow read, write: if ehFuncionario(); }
    match /clients/{id}     { allow read, write: if ehFuncionario(); }
    match /customers/{id}   { allow read, write: if ehFuncionario(); }
    match /promos/{id}      { allow read, write: if ehFuncionario(); }
    match /config/{id}      { allow read, write: if ehFuncionario(); }

    // ── Produtos e anúncios: as coleções da área do cliente ────────────
    // O produto é do PROPRIETÁRIO (custId), não da loja: é isso que faz as
    // três lojas da mesma pessoa aparecerem juntas na tela dele.
    //
    // `mkts` é cópia dos marketplaces do proprietário, gravada por trigger e
    // não pelo cliente. Existe para o especialista filtrar sem que a regra
    // precise ler o documento do proprietário a cada produto — o mesmo
    // motivo das claims. Por isso o cliente não pode escrever esse campo:
    // se pudesse, ele decidiria quem enxerga o produto dele.
    match /products/{id} {
      allow read: if ehFuncionario()
        || (ehCliente() && resource.data.custId == meuCust())
        || (ehEspecialista() && meuMkt() in resource.data.get("mkts", []));
      allow create: if ehFuncionario()
        || (ehCliente()
            && request.resource.data.custId == meuCust()
            && !request.resource.data.keys().hasAny(["mkts"]));
      // O cliente edita o que é dele, mas não muda de dono nem mexe no mkts.
      allow update: if ehFuncionario()
        || (ehCliente()
            && resource.data.custId == meuCust()
            && request.resource.data.custId == resource.data.custId
            && request.resource.data.get("mkts", []) == resource.data.get("mkts", []));
      allow delete: if ehFuncionario();
    }

    // Um anúncio pertence a um marketplace. O cliente LÊ os dele e não
    // escreve nenhum: quem anuncia é a OTDE ou o especialista. O
    // especialista escreve só dentro do marketplace dele, e não pode
    // arrastar um anúncio para outro marketplace nem na criação nem na
    // edição — as duas pontas são checadas de propósito.
    match /listings/{id} {
      // O especialista LÊ os anúncios de qualquer marketplace do produto que
      // ele atende, e não só os do dele. Não é folga: preço de anúncio é
      // público, está na vitrine do marketplace. E sem a referência do que o
      // produto custa na Shopee ele não tem como precificar no dele — que é
      // exatamente o trabalho que a conta existe para fazer.
      //
      // `mkts` no anúncio é cópia do mesmo campo do produto, gravada na
      // importação. Existe para a regra não precisar ler o produto a cada
      // anúncio — o mesmo motivo das claims.
      allow read: if ehFuncionario()
        || (ehCliente() && resource.data.custId == meuCust())
        || (ehEspecialista() && meuMkt() in resource.data.get("mkts", []));
      allow create: if ehFuncionario()
        || (ehEspecialista() && request.resource.data.mkt == meuMkt());
      allow update: if ehFuncionario()
        || (ehEspecialista()
            && resource.data.mkt == meuMkt()
            && request.resource.data.mkt == meuMkt());
      allow delete: if ehFuncionario();
    }

    // NOTA sobre clients e customers: nenhum papel externo lê essas coleções,
    // e não é esquecimento. `clients.access` guarda a SENHA da loja no
    // marketplace, e regra do Firestore não esconde campo — ou o documento
    // inteiro é legível, ou não é. O que a área do cliente precisar de lá vai
    // por uma projeção escrita pelo backend, com só o que pode sair.

    // ── Dados sensíveis: leitura para funcionários, escrita restrita ───
    // performance tem dados financeiros dos clientes: só admin escreve.
    match /performance/{id} { allow read: if ehFuncionario(); allow write: if ehAdmin(); }

    // ── Preenchidas pelo backend (Admin SDK). Navegador só lê ──────────
    match /sales/{id}       { allow read: if ehFuncionario(); allow write: if false; }
    match /tools/{id}       { allow read: if ehFuncionario(); allow write: if false; }
    match /integracoes/{id} { allow read: if ehFuncionario(); allow write: if false; }
    // Conferência diária. Escrita bloqueada de propósito: se o navegador
    // pudesse gravar aqui, daria para "apagar" um alerta de divergência.
    match /conferencias/{id} { allow read: if ehFuncionario(); allow write: if false; }

    // ── Tokens da Shopee: nenhum acesso pelo navegador ─────────────────
    match /shopee_auth/{id} { allow read, write: if false; }

    // ── Qualquer outra coleção: negado por padrão ──────────────────────
    match /{outra=**} { allow read, write: if false; }
  }
}
