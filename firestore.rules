rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Papéis ─────────────────────────────────────────────────────────
    // Estar logado NÃO basta: o Firebase Auth aceita cadastro de qualquer
    // pessoa (a apiKey do front é pública por design). O que dá acesso é
    // existir um cadastro de funcionário criado por um administrador.
    function ehFuncionario() {
      return request.auth != null
        && exists(/databases/$(database)/documents/employees/$(request.auth.uid));
    }
    function ehAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.role == "admin";
    }

    // ── Funcionários ───────────────────────────────────────────────────
    // Criação/edição/exclusão SÓ pelo backend (Admin SDK, ignora as regras)
    // ou por um admin já existente. Ninguém se auto-cadastra.
    match /employees/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || ehAdmin());
      allow create, delete: if ehAdmin();
      // Admin edita qualquer um; o próprio pode editar seu cadastro,
      // mas NUNCA mudar o próprio papel.
      allow update: if ehAdmin()
        || (request.auth.uid == uid
            && request.resource.data.role == resource.data.role);
    }

    // ── Dados operacionais: qualquer funcionário ───────────────────────
    match /tasks/{id}       { allow read, write: if ehFuncionario(); }
    match /clients/{id}     { allow read, write: if ehFuncionario(); }
    match /customers/{id}   { allow read, write: if ehFuncionario(); }
    match /products/{id}    { allow read, write: if ehFuncionario(); }
    match /promos/{id}      { allow read, write: if ehFuncionario(); }
    match /config/{id}      { allow read, write: if ehFuncionario(); }

    // ── Dados sensíveis: leitura para funcionários, escrita restrita ───
    // performance tem dados financeiros dos clientes: só admin escreve.
    match /performance/{id} { allow read: if ehFuncionario(); allow write: if ehAdmin(); }

    // ── Preenchidas pelo backend (Admin SDK). Navegador só lê ──────────
    match /sales/{id}       { allow read: if ehFuncionario(); allow write: if false; }
    match /tools/{id}       { allow read: if ehFuncionario(); allow write: if false; }
    match /integracoes/{id} { allow read: if ehFuncionario(); allow write: if false; }

    // ── Tokens da Shopee: nenhum acesso pelo navegador ─────────────────
    match /shopee_auth/{id} { allow read, write: if false; }

    // ── Qualquer outra coleção: negado por padrão ──────────────────────
    match /{outra=**} { allow read, write: if false; }
  }
}
